# Copy to protected .env.production OUTSIDE the checkout/build context.
# .env.production is also ignored by Git if accidentally placed in the checkout.
# NEVER commit the filled file or print expanded Compose configuration.
# Immutable Docker image ID, verified after loading the workstation archive.
PORTAL_APP_IMAGE=
# Inspect the original portal project's existing user-defined network; do not guess.
PORTAL_EXISTING_NETWORK=
PORTAL_APP_UID=
PORTAL_APP_GID=
SESSION_SECRET=
# Credential-free internal URL using a VERIFIED existing DNS name.
PORTAL_COUCHDB_URL=
COUCHDB_USER=
COUCHDB_PASSWORD=
# Include Redis authentication here only if required by the verified current service.
PORTAL_REDIS_URL=
# User-reported existing legacy bind. Verify canonical path and read access.
NAS_FILES_HOST_PATH=/volume1/docker/portal/files
# Select a SEPARATE existing dedicated managed root, never the legacy files directory.
PORTAL_UPLOADS_HOST_PATH=
PORTAL_UPLOADS_STORAGE_ID=
PORTAL_UPLOAD_MIN_FREE_BYTES=
PORTAL_UPLOAD_MAX_OBJECTS_PER_USER=1000
