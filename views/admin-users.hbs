<section class="page-header">
  <h1>User management</h1>
  <p>Signed in as <strong>{{user.username}}</strong> (administrator).</p>
</section>
{{#if notice}}<p role="status">{{notice}}</p>{{/if}}
{{#if error}}<p role="alert">{{error}}</p>{{/if}}
<div class="grid two-col">
  <div class="card">
    <h2>Create user</h2>
    <form method="POST" action="/admin/users">
      <input type="hidden" name="_csrf" value="{{csrfToken}}" />
      <label>Username<input name="username" required /></label>
      <label>Email<input name="email" type="email" required /></label>
      <label>Password<input name="password" type="password" required /></label>
      <label>Role
        <select name="role">
          <option value="member">member</option>
          <option value="admin">admin</option>
        </select>
      </label>
      <button type="submit">Create user</button>
    </form>
  </div>
  <div class="card">
    <h2>Current users</h2>
    <table>
      <thead><tr><th>User</th><th>Role</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        {{#each users}}
        <tr>
          <td>{{this.username}}</td>
          <td>{{this.role}}</td>
          <td>{{#if this.isActive}}Active{{else}}Disabled{{/if}}</td>
          <td>
            {{#if this.isSelf}}<span>Current account. Self-disable is prohibited.</span>{{/if}}
            {{#if this.isLastActiveAdmin}}<span>Protected: last active administrator.</span>{{/if}}
            {{#if this.canDisable}}
              <a href="/admin/users/{{this._id}}/disable" aria-label="Review disabling {{this.username}}">Disable</a>
            {{/if}}
            {{#unless this.isActive}}
              <form method="POST" action="/admin/users/{{this._id}}/enable">
                <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                <button type="submit" aria-label="Enable {{this.username}}">Enable</button>
              </form>
            {{/unless}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
