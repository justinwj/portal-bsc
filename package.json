{
  "name": "portal-bsc",
  "version": "1.0.0",
  "description": "Secure internal file portal for Synology NAS deployments",
  "private": true,
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "node dist/main.js",
    "start:dev": "node scripts/dev.cjs",
    "start:debug": "node scripts/dev.cjs --inspect",
    "typecheck": "tsc -p tsconfig.check.json",
    "seed:admin": "ts-node src/seed-admin.ts",
    "seed:admin:prod": "node dist/seed-admin.js",
    "test": "node scripts/run-tests.cjs",
    "test:integration": "node scripts/run-tests.cjs integration",
    "test:persistence": "node scripts/run-tests.cjs persistence",
    "test:tooling": "node scripts/run-tests.cjs tooling"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justinwj/portal-bsc.git"
  },
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "connect-redis": "^7.0.0",
    "dotenv": "^16.4.7",
    "express": "5.2.1",
    "express-handlebars": "^9.0.4",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.17.3",
    "helmet": "^8.0.0",
    "nano": "^10.0.0",
    "redis": "^5.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.6.0",
    "uuid": "^14.0.2"
  },
  "overrides": {
    "multer": "2.5.0",
    "lodash": "4.18.1",
    "qs": "6.16.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.17.3",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "js-yaml": "4.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
