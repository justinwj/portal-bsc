# --- Application ---
# Required: host/port the app binds to in local development.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Required: session/auth secret.
# Development-only placeholder; replace with your own local random value.
SESSION_SECRET=replace-with-a-long-random-local-secret

# --- Data stores ---
# Required: local Redis connection used by app/session/cache features.
# Development-only default points to local compose service.
REDIS_URL=redis://localhost:6379

# Required: local CouchDB connection used by persistence features.
# Development-only defaults point to local compose service.
COUCHDB_URL=http://localhost:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=password

# --- Bootstrap ---
# Required for first-run admin seeding.
# Development-only placeholders; do not use in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-local-only
