NODE_ENV=development
PORT=3000
SESSION_SECRET=
REDIS_URL=redis://redis:6379
COUCHDB_URL=http://couchdb:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=
NAS_FILES_DIR=/var/lib/portal-bsc/files
# Required for production Compose: choose the existing absolute NAS files path.
# Compose must reject a missing path rather than create a replacement directory.
NAS_FILES_HOST_PATH=
# Initial bootstrap only: supply a strong password, then remove all ADMIN_* entries
# from the runtime environment and recreate the app container after verification.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
DEFAULT_USER_ROLE=member
ALLOW_IN_MEMORY_SESSION_STORE=true
