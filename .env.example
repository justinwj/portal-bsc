NODE_ENV=development
PORT=3000
SESSION_SECRET=
REDIS_URL=redis://redis:6379
COUCHDB_URL=http://couchdb:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=
NAS_FILES_DIR=/var/lib/portal-bsc/files
# Required for production Compose: choose the existing absolute NAS files path.
# Compose must reject a missing path rather than create a replacement directory.
NAS_FILES_HOST_PATH=
# Initial bootstrap only: supply a strong password, then remove all ADMIN_* entries
# from the runtime environment and recreate the app container after verification.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
DEFAULT_USER_ROLE=member
ALLOW_IN_MEMORY_SESSION_STORE=true
# Production app identity: verify actual DSM UID/GID and permissions; never root.
PORTAL_APP_UID=
PORTAL_APP_GID=
# Managed uploads are opt-in. Keep legacy NAS storage read-only and separate.
PORTAL_UPLOADS_ENABLED=false
PORTAL_UPLOADS_DIR=
PORTAL_UPLOADS_HOST_PATH=
PORTAL_UPLOADS_STORAGE_ID=
# Required positive physical disk headroom in bytes when uploads are enabled.
PORTAL_UPLOAD_MIN_FREE_BYTES=
PORTAL_UPLOAD_MAX_OBJECTS_PER_USER=1000
